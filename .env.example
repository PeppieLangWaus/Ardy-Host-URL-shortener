# Port the server listens on inside the container.
PORT=3000

# Domain this service is reachable at — used to build the shortUrl returned by POST /api/links.
BASE_DOMAIN=link.ardy.host

# Exact origin+path a submitted URL must match before it's even looked at further.
# This is the first half of the anti-abuse gate — see README "Security model".
SETUP_URL_PREFIX=https://splasher.help/setup

# Must be IDENTICAL to SETUP_LINK_SECRET (or the JWT_SECRET it falls back to) in
# splash-helper-backend/.env — this is what proves a token was actually issued by
# that backend, not just crafted to look right. Rotate both together.
SETUP_LINK_SECRET=change-me-must-match-splash-helper-backend

# Shared secret splash-helper-backend sends as X-API-Key when calling POST /api/links.
# Generate with: openssl rand -hex 32
API_KEY=change-me-generate-a-long-random-value

# Where the SQLite file lives. In Coolify, mount a persistent volume at this path
# (or its parent directory) so link data survives redeploys.
DATABASE_PATH=/data/links.db
